# Copia este archivo como .env y completa las claves en TU laptop.
PORT=3000
QR_SECRET=CAMBIAR_CON_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_32_CARACTERES
ADMIN_KEY=CAMBIAR_CON_OTRA_CLAVE_ALEATORIA_DE_AL_MENOS_32_CARACTERES
GMAIL_USER=
GMAIL_APP_PASSWORD=
IA_API_KEY=
# HTTPS opcional con mkcert; no incluir certificados privados en Git.
# HTTPS_KEY_PATH=certs/lince-local-key.pem
# HTTPS_CERT_PATH=certs/lince-local.pem
# Segundos mínimos entre dos lecturas de la misma persona (por defecto 60).
# Para la demo de entrar y salir seguido se puede bajar, ej. 10.
# ANTIRREBOTE_SEGUNDOS=60

# Clave con la que el personal de seguridad entra al panel (dashboard/login.html).
# Si no está, se usa ADMIN_KEY. Usa una frase larga que solo conozca seguridad.
CLAVE_SEGURIDAD=CAMBIAR_POR_LA_CLAVE_DEL_PERSONAL_DE_SEGURIDAD

# LinceTutores · avisos al celular (Web Push). Genera el par con: npx web-push generate-vapid-keys
# Sin estas claves la app de tutores funciona, solo sin notificaciones push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@ejemplo.com
